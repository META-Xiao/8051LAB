line level    source

   1          /**
   2           * HC-SR04 原理:
   3           *   Trig >= 10us 触发 → 模块发 8 个 40kHz 脉冲
   4           *   → Echo 输出高电平，持续 = 超声波往返时间
   5           *   → distance(cm) = Echo_time(us) / 58.8
   6           *
   7           * T0 时钟 = sysclk/12 = 24.5MHz/12 ≈ 2.0417MHz
   8           * 1 tick ≈ 0.49us
   9           * distance = ticks * 0.49 / 58.8 = ticks / 120
  10           */
  11          
  12          #include "ultrasonic.h"
  13          #include "intrins.h"
  14          
  15          static void ultraDelayUs(uint us)
  16          {
  17   1          uchar i;
  18   1          while (us--) {
  19   2              for (i = 0; i < 4; i++) {
  20   3                  _nop_();
  21   3              }
  22   2          }
  23   1      }
  24          
  25          void ultraInit(void)
  26          {
  27   1          P0MDOUT |= 0x01;
  28   1          TRIG = 0;
  29   1      }
  30          
  31          uint ultraRead(void)
  32          {
  33   1          uint ticks;
  34   1          bit savedEA;
  35   1      
  36   1          TH0 = 0x00;
  37   1          TL0 = 0x00;
  38   1          TR0 = 0;
  39   1      
  40   1          TRIG = 1;
  41   1          ultraDelayUs(15);
  42   1          TRIG = 0;
  43   1      
  44   1          savedEA = EA;
  45   1          EA = 0;
  46   1      
  47   1          while (!ECHO);
  48   1          TR0 = 1; // 反复开关TR防止ECHO被其他定时器冲突
  49   1          while (ECHO);
  50   1          TR0 = 0;
  51   1      
  52   1          EA = savedEA;
  53   1      
  54   1          ticks = (TH0 << 8) | TL0;
C51 COMPILER V9.60.7.0   ULTRASONIC                                                        06/14/2026 21:01:15 PAGE 2   

  55   1          return (uint)((ulong)ticks / 120UL);
  56   1      }


