   1          /* PCF8591 数字电压表
   2             I2C: P0.3(SCL) P0.2(SDA), AIN1 模拟输入 */
   3          #include "sysinit.h"
   4          #include "uart.h"
   5          #include "pcf8591.h"
   6          #include "segdisplay.h"
   7          #include "stdio.h"
   8          
   9          void main(void)
  10          {
  11   1          uint val;
  12   1          uint mV;
  13   1          uint lastVal = 0xFFFF;
  14   1          uchar i;
  15   1      
  16   1          sysInit();
  17   1          uartInit();
  18   1          segInit();
  19   1          pcf8591Init();
  20   1      
  21   1          printf("\r\n=== PCF8591 Voltmeter ===\r\n");
  22   1      
  23   1          while (1) {
  24   2              val = pcf8591ReadADC(1);
  25   2              mV = (uint)((ulong)val * 5000UL / 255UL);
  26   2      
  27   2              if (val != lastVal) {
  28   3                  printf("AIN1: %3u (%u.%03uV)\r\n",
  29   3                         val, mV / 1000, mV % 1000);
  30   3                  lastVal = val;
  31   3              }
  32   2      
  33   2              for (i = 0; i < 50; i++) {
  34   3                  segShowRaw(0, segCode(mV / 1000)& 0x7F);
  35   3                  segShowRaw(1, segCode((mV / 100) % 10));
  36   3                  segShowRaw(2, segCode((mV / 10) % 10));
  37   3                  segShowRaw(3, segCode(mV % 10));
  38   3              }
  39   2          }
  40   1      }


