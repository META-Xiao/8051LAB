   1          /**
   2           * KeyBoard — 4×4 矩阵键盘 P2 + UART 调试 P0
   3           *
   4           * 硬件: P2 → 4×4 矩阵键盘 (P2.0~3行, P2.4~7列)
   5           *       P0.4/P0.5 → UART TX/RX
   6           *       P1.0~P1.3 → 数码管位选, P2 → 段选(已挪走)
   7           *
   8           * 注意: 键盘搬到 P2 避免和 UART(P0) 冲突
   9           */
  10          #include "sysinit.h"
  11          #include "uart.h"
  12          #include "stdio.h"
  13          
  14          /* 简单延时 */
  15          static void kbdDelay(void)
  16          {
  17   1          uint i;
  18   1          for (i = 0; i < 6000; i++);
  19   1      }
  20          
  21          /* ===== 键盘 P2 引脚 ===== */
  22          #define KBD_PORT  P2
  23          
  24          /* 行列编码表 */
  25          static uchar code keyCode[16] = {
  26              0x77,0xB7,0xD7,0xE7, 0x7B,0xBB,0xDB,0xEB,
  27              0x7D,0xBD,0xDD,0xED, 0x7E,0xBE,0xDE,0xEE
  28          };
  29          
  30          /** 查表: 编码 → 键号 1~16, 无效返回 0 */
  31          uchar kbdDecode(uchar kc)
  32          {
  33   1          uchar j;
  34   1          for (j = 0; j < 16; j++)
  35   1              if (kc == keyCode[j]) return j + 1;
  36   1          return 0;
  37   1      }
  38          
  39          /** 行列反转扫描, 返回键号 1~16, 无键返回 0 */
  40          uchar kbdScan(void)
  41          {
  42   1          uchar s1, s2, kc;
  43   1      
  44   1          KBD_PORT = 0xF0;
  45   1          s1 = KBD_PORT;
  46   1          if ((s1 & 0xF0) == 0xF0) return 0;
  47   1      
  48   1          kbdDelay();                      /* 去抖 */
  49   1      
  50   1          KBD_PORT = 0xF0;
  51   1          s1 = KBD_PORT;
  52   1          if ((s1 & 0xF0) == 0xF0) return 0;
  53   1      
  54   1          KBD_PORT = 0x0F;
C51 COMPILER V9.60.7.0   MAIN                                                              06/27/2026 14:56:17 PAGE 2   

  55   1          s2 = KBD_PORT;
  56   1          kc = s1 | s2;
  57   1          return kbdDecode(kc);
  58   1      }
  59          
  60          void main(void)
  61          {
  62   1          uchar key, lastKey = 0;
  63   1      
  64   1          sysInit();
  65   1          uartInit();
  66   1          P2MDOUT = 0x0F;
  67   1          P2      = 0xFF;
  68   1      
  69   1          printf("\r\n=== Keyboard Debug (P2) ===\r\n");
  70   1      
  71   1          while (1)
  72   1          {
  73   2              key = kbdScan();
  74   2      
  75   2              if (key && key != lastKey)
  76   2              {
  77   3                  printf("Key: %2u\r\n", (uint)key);
  78   3                  lastKey = key;
  79   3              }
  80   2              if (!key) lastKey = 0;
  81   2          }
  82   1      }


