   1          /**
   2           * keyboard.c — 4×4 矩阵键盘扫描实现
   3           *
   4           * 行列反转扫描法:
   5           *   1. 行输出低电平, 列输入(上拉), 读列状态
   6           *   2. 列输出低电平, 行输入(上拉), 读行状态
   7           *   3. 组合行列编码 → 查表得键号 1~16
   8           */
   9          
  10          #include "keyboard.h"
  11          #include "intrins.h"
  12          
  13          /* ===== 4×4 键盘行列编码表 ===== */
  14          static uchar code key_code[16] = {
  15              0xEE, 0xDE, 0xBE, 0x7E,   /* 第0行: 键1 ~ 键4  */
  16              0xED, 0xDD, 0xBD, 0x7D,   /* 第1行: 键5 ~ 键8  */
  17              0xEB, 0xDB, 0xBB, 0x7B,   /* 第2行: 键9 ~ 键12 */
  18              0xE7, 0xD7, 0xB7, 0x77    /* 第3行: 键13 ~ 键16 */
  19          };
  20          
  21          /* ===== 内部延时 ===== */
  22          static void keyDelayMs(uint ms)
  23          {
  24   1          uchar i, j;
  25   1          while (ms--) {
  26   2              for (i = 0; i < 25; i++) {
  27   3                  for (j = 0; j < 250; j++) {
  28   4                      _nop_();
  29   4                  }
  30   3              }
  31   2          }
  32   1      }
  33          
  34          /* ===== 初始化键盘端口 ===== */
  35          void keyboardInit(void)
  36          {
  37   1          P0MDIN =0xFF, P0MDOUT=0x00;
  38   1          P0=0xFF;   /* P0 全部拉高 (关断, 等待输入) */
  39   1      }
  40          
  41          /* ===== 查表===== */
  42          uchar keyboardDecode(uchar keycode)
  43          {
  44   1          uchar j;
  45   1          for (j = 0; j <= 15; j++)
  46   1          {
  47   2              if(keycode==key_code[j]) return j + 1;
  48   2          }
  49   1          return 0;
  50   1      }
  51          
  52          /* ===== 阻塞式行列反转扫描 (保留兼容) ===== */
  53          uchar keyscan(void)
  54          {
C51 COMPILER V9.60.7.0   KEYBOARD                                                          06/27/2026 16:01:40 PAGE 2   

  55   1          uchar scan1, scan2, keycode, j;
  56   1          P0=0xF0;
  57   1          scan1=P0;
  58   1          if((scan1 & 0xF0) != 0xF0)
  59   1          {
  60   2              keyDelayMs(20);
  61   2              scan1=P0;
  62   2              if((scan1 & 0xF0) != 0xF0)   /* 二次确认 */
  63   2              {
  64   3                  P0=0x0F, scan2=P0;
  65   3                  keycode = scan1 | scan2;   /* 组合行列编码 */
  66   3                  for(j = 0; j <= 15; j++)
  67   3                  {
  68   4                      if (keycode == key_code[j])
  69   4                          return j+1;
  70   4                  }
  71   3              }
  72   2          }
  73   1          return KEY_NONE;
  74   1      }


