  20          static uchar keyScan(void)
  21          {
  22   1          uchar s1, s2, kc, j;
  23   1          P2 = 0xF0; s1 = P2;
  24   1          if ((s1 & 0xF0) == 0xF0) return 0;
  25   1          { uint d; for (d = 0; d < 6000; d++); }
  26   1          P2 = 0xF0; s1 = P2;
  27   1          if ((s1 & 0xF0) == 0xF0) return 0;
  28   1          P2 = 0x0F; s2 = P2;
  29   1          kc = s1 | s2;
  30   1          for (j = 0; j < 16; j++)
  31   1              if (kc == keyTable[j]) return j + 1;
  32   1          return 0;
  33   1      }
  34          
  35          static void delayShort(void) { uint i; for (i = 0; i < 30000; i++); }
  36          
  37          /** 延时并轮询按键, 按Key2返回1提前退出 */
  38          static uchar delayPoll(uchar n)
  39          {
  40   1          while (n--) {
  41   2              delayShort();
  42   2              if (keyScan() == 2) return 1;
  43   2          }
  44   1          return 0;
  45   1      }
