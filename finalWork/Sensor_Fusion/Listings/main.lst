  19          static uchar keyScan(void)
  20          {
  21   1          uchar s1, s2, kc, j;
  22   1          P2 = 0xF0; s1 = P2;
  23   1          if ((s1 & 0xF0) == 0xF0) return 0;
  24   1          { uint d; for (d = 0; d < 6000; d++); }
  25   1          P2 = 0xF0; s1 = P2;
  26   1          if ((s1 & 0xF0) == 0xF0) return 0;
  27   1          P2 = 0x0F; s2 = P2;
  28   1          kc = s1 | s2;
  29   1          for (j = 0; j < 16; j++)
  30   1              if (kc == keyTable[j]) return j + 1;
  31   1          return 0;
  32   1      }
  33          
  34          static void delayShort(void) { uint i; for (i = 0; i < 30000; i++); }
  35          
  36          /**
  37           * 在 (x,y) 以ASCII显示 val×100, 格式 XX.XX
  38           */
  39          static void oledShowFloat(uchar x, uchar y, uint val)
  40          {
  41   1          uchar buf[7];
  42   1          buf[0] = '0' + (val / 1000) % 10;
  43   1          buf[1] = '0' + (val / 100) % 10;
  44   1          buf[2] = '.';
  45   1          buf[3] = '0' + (val / 10) % 10;
  46   1          buf[4] = '0' + val % 10;
  47   1          buf[5] = 0;
  48   1          oledShowStr(x, y, buf);
  49   1      }
