 183          void oledShowNum(uchar x, uchar y, ulong num, uchar len, uchar size)
 184          {
 185   1          uchar t, temp, enshow = 0;
 186   1      
 187   1          for (t = 0; t < len; t++) {
 188   2              temp = (num / oledPow10(len - t - 1)) % 10;
