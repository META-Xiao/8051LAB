 123          void oledShowChar(uchar x, uchar y, uchar chr)
 124          {
 125   1          uchar c, i;
 126   1      
 127   1          c = chr - ' ';
 128   1          if (x > OLED_COL_MAX - 1) { x = 0; y += 2; }
 129   1      
 130   1          oledSetPos(x, y);
 131   1          for (i = 0; i < 8; i++)
 132   1              oledWriteByte(f8x16[c * 16 + i], OLED_DATA);
 133   1          oledSetPos(x, y + 1);
 134   1          for (i = 0; i < 8; i++)
 135   1              oledWriteByte(f8x16[c * 16 + i + 8], OLED_DATA);
 136   1      }
 137          
 138          void oledShowStr(uchar x, uchar y, uchar *str)
 139          {
