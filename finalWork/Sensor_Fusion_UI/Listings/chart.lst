  73   2              uchar v   = buf[(idx + i) & (BUF_SIZE - 1)];
  74   2              uchar bar = (yMax > 0) ? (uchar)((uint)v * pxH / yMax) : 0;
  75   2              if (bar > pxH) bar = pxH;
  76   2              fbCol(i * 2,     bar);
  77   2              fbCol(i * 2 + 1, bar);
  78   2          }
