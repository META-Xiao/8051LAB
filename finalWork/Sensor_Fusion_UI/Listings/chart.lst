  62   2              for (x = 0; x < MAX_COL; x++)
  63   2                  oledWriteByte(fb[p * MAX_COL + x], 1);
  64   2          }
  65   1          EA = savedEA;
  66   1      }
  67          
  68          static void chartDraw(void)
  69          {
  70   1          uchar i;
  71   1          /* 不 fbClear! 帧缓冲保留上一帧, 新柱直接覆盖 */
