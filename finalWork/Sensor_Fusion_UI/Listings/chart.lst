   1          /**
   2           * chart.c — OLED 实时曲线图
   3           *
   4           * 在指定页面区域绘制 64 点柱状曲线, 128×N px, 自适应 Y 轴
   5           */
   6          #include "chart.h"
   7          #include "oled7pin.h"
   8          
   9          #define BUF_SIZE 64
  10          
  11          static uchar xdata buf[BUF_SIZE];
  12          static uchar idx, y0, pages, pxH, yMax;
  13          
  14          static uchar code barMask[9] = {
  15              0x00, 0x80, 0xC0, 0xE0, 0xF0, 0xF8, 0xFC, 0xFE, 0xFF
  16          };
  17          
  18          void chartInit(uchar startPage, uchar numPages, uchar initMax)
  19          {
  20   1          uchar i;
  21   1          y0    = startPage;
  22   1          pages = numPages;
  23   1          pxH   = numPages * 8;
  24   1          yMax  = initMax ? initMax : 1;
  25   1          idx   = 0;
  26   1          for (i = 0; i < BUF_SIZE; i++) buf[i] = 0;
  27   1      }
  28          
  29          /** 清空图表区域 */
  30          static void chartClear(void)
  31          {
  32   1          uchar y, x;
  33   1          for (y = 0; y < pages; y++) {
  34   2              oledWriteByte(0xB0 + y0 + y, 0);  /* set page */
  35   2              oledWriteByte(0x00, 0);            /* col low */
  36   2              oledWriteByte(0x10, 0);            /* col high */
  37   2              for (x = 0; x < 128; x++)
  38   2                  oledWriteByte(0x00, 1);
  39   2          }
  40   1      }
  41          
  42          /** 画一列: x 位置, 高 valPx 像素(0=底, pxH=满) */
  43          static void chartCol(uchar x, uchar valPx)
  44          {
  45   1          uchar p;
  46   1          int   barTop;
  47   1      
  48   1          barTop = (int)(y0 + pages) * 8 - (int)valPx;
  49   1      
  50   1          for (p = 0; p < pages; p++) {
  51   2              int   pageTop = (int)(y0 + p) * 8;
  52   2              int   pageBot = pageTop + 7;
  53   2              uchar mask;
  54   2      
C51 COMPILER V9.60.7.0   CHART                                                             06/27/2026 17:46:19 PAGE 2   

  55   2              if (barTop > pageBot)      mask = 0x00;
  56   2              else if (barTop <= pageTop) mask = 0xFF;
  57   2              else                       mask = barMask[pageBot - barTop + 1];
  58   2      
  59   2              oledWriteByte(0xB0 + y0 + p, 0);          /* 每页独立设地址 */
  60   2              oledWriteByte(((x & 0xF0) >> 4) | 0x10, 0);
  61   2              oledWriteByte((x & 0x0F) | 0x01, 0);
  62   2              oledWriteByte(mask, 1);
  63   2          }
  64   1      }
  65          
  66          /** 重绘全部曲线 */
  67          static void chartDraw(void)
  68          {
  69   1          uchar i;
  70   1          chartClear();
  71   1          for (i = 0; i < BUF_SIZE; i++) {
  72   2              uchar v   = buf[(idx + i) & (BUF_SIZE - 1)];
  73   2              uchar bar = (yMax > 0) ? (uchar)((uint)v * pxH / yMax) : 0;
  74   2              if (bar > pxH) bar = pxH;
  75   2              chartCol(i * 2,     bar);  /* 每bar 2px宽 */
  76   2              chartCol(i * 2 + 1, bar);
  77   2          }
  78   1      }
  79          
  80          void chartReset(uchar newMax)
  81          {
  82   1          uchar i;
  83   1          idx  = 0;
  84   1          yMax = newMax ? newMax : 1;
  85   1          for (i = 0; i < BUF_SIZE; i++) buf[i] = 0;
  86   1          chartClear();
  87   1      }
  88          
  89          void chartPush(uchar val)
  90          {
  91   1          uchar i;
  92   1          buf[idx] = val;
  93   1          idx = (idx + 1) & (BUF_SIZE - 1);
  94   1      
  95   1          yMax = 0;
  96   1          for (i = 0; i < BUF_SIZE; i++)
  97   1              if (buf[i] > yMax) yMax = buf[i];
  98   1          if (yMax == 0) yMax = 1;
  99   1      
 100   1          chartDraw();
 101   1      }


