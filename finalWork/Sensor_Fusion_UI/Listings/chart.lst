   4          #include "config.h"
   5          
   6          #define BUF_SIZE 64
   7          #define MAX_COL  128
   8          
   9          static uchar xdata fb[MAX_COL * 7];    /* 帧缓冲 XDATA */
  10          static uchar xdata buf[BUF_SIZE];
  11          static uchar idx, y0, pages, pxH, yMax;
  12          
  13          static uchar code barMask[9] = {
  14              0x00, 0x80, 0xC0, 0xE0, 0xF0, 0xF8, 0xFC, 0xFE, 0xFF
  15          };
  16          
  17          void chartInit(uchar startPage, uchar numPages, uchar initMax)
  18          {
  19   1          uchar i;
  20   1          y0    = startPage;
  21   1          pages = numPages;
  22   1          pxH   = numPages * 8;
  23   1          yMax  = initMax ? initMax : 1;
  24   1          idx   = 0;
  25   1          for (i = 0; i < BUF_SIZE; i++) buf[i] = 0;
  26   1      }
  27          
  28          /* 帧缓冲画一列 */
  29          static void fbCol(uchar x, uchar valPx)
  30          {
  31   1          uchar p;
  32   1          int   barTop;
  33   1          barTop = (int)(y0 + pages) * 8 - (int)valPx;
  34   1          for (p = 0; p < pages; p++) {
  35   2              int   pageTop = (int)(y0 + p) * 8;
  36   2              int   pageBot = pageTop + 7;
  37   2              uchar mask;
  38   2              if (barTop > pageBot)      mask = 0x00;
  39   2              else if (barTop <= pageTop) mask = 0xFF;
  40   2              else                       mask = barMask[pageBot - barTop + 1];
  41   2              fb[p * MAX_COL + x] = mask;
  42   2          }
  43   1      }
  44          
  45          static void fbClear(void)
  46          {
  47   1          uint i;
  48   1          for (i = 0; i < (uint)pages * MAX_COL; i++) fb[i] = 0;
  49   1      }
  50          
  51          /* 帧缓冲 */
  52          static void fbFlush(void)
  53          {
  54   1          uchar p, savedEA;
C51 COMPILER V9.60.7.0   CHART                                                             06/29/2026 15:51:41 PAGE 2   

  55   1          uint  x;
  56   1          savedEA = EA;  EA = 0;          /* 传输期间关中断防撕裂 */
  57   1          for (p = 0; p < pages; p++) {
  58   2              oledWriteByte(0xB0 + y0 + p, 0);
  59   2              oledWriteByte(0x00, 0);
  60   2              oledWriteByte(0x10, 0);
  61   2              for (x = 0; x < MAX_COL; x++)
  62   2                  oledWriteByte(fb[p * MAX_COL + x], 1);
  63   2          }
  64   1          EA = savedEA;
  65   1      }
  66          
  67          static void chartDraw(void)
  68          {
  69   1          uchar i;
  70   1          /* 不 fbClear! 帧缓冲保留上一帧, 新柱直接覆盖 */
  71   1          for (i = 0; i < BUF_SIZE; i++) {
  72   2              uchar v   = buf[(idx + i) & (BUF_SIZE - 1)];
  73   2              uchar bar = (yMax > 0) ? (uchar)((uint)v * pxH / yMax) : 0;
  74   2              if (bar > pxH) bar = pxH;
  75   2              fbCol(i * 2,     bar);
  76   2              fbCol(i * 2 + 1, bar);
  77   2          }
  78   1          fbFlush();
  79   1      }
  80          
  81          void chartReset(uchar newMax)
