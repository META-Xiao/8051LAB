   4          #include "chart.h"
   5          #include "oled7pin.h"
   6          
   7          #define BUF_SIZE 64
   8          #define MAX_COL  128
   9          
  10          static uchar xdata fb[MAX_COL * 7];    /* 帧缓冲 XDATA */
  11          static uchar xdata buf[BUF_SIZE];
  12          static uchar idx, y0, pages, pxH, yMax;
  13          
  14          static uchar code barMask[9] = {
  15              0x00, 0x80, 0xC0, 0xE0, 0xF0, 0xF8, 0xFC, 0xFE, 0xFF
  16          };
  17          
  18          void chartInit(uchar startPage, uchar numPages, uchar initMax)
  19          {
  20   1          uchar i;
  21   1          y0    = startPage;
  22   1          pages = numPages;
  23   1          pxH   = numPages * 8;
  24   1          yMax  = initMax ? initMax : 1;
  25   1          idx   = 0;
  26   1          for (i = 0; i < BUF_SIZE; i++) buf[i] = 0;
  27   1      }
  28          
  29          /* 帧缓冲画一列 */
  30          static void fbCol(uchar x, uchar valPx)
  31          {
  32   1          uchar p;
  33   1          int   barTop;
  34   1          barTop = (int)(y0 + pages) * 8 - (int)valPx;
  35   1          for (p = 0; p < pages; p++) {
  36   2              int   pageTop = (int)(y0 + p) * 8;
  37   2              int   pageBot = pageTop + 7;
  38   2              uchar mask;
  39   2              if (barTop > pageBot)      mask = 0x00;
  40   2              else if (barTop <= pageTop) mask = 0xFF;
  41   2              else                       mask = barMask[pageBot - barTop + 1];
  42   2              fb[p * MAX_COL + x] = mask;
  43   2          }
  44   1      }
  45          
  46          static void fbClear(void)
  47          {
  48   1          uint i;
  49   1          for (i = 0; i < (uint)pages * MAX_COL; i++) fb[i] = 0;
  50   1      }
  51          
  52          /* 帧缓冲→OLED (关中断, 尽量原子) */
  53          static void fbFlush(void)
  54          {
C51 COMPILER V9.60.7.0   CHART                                                             06/27/2026 18:19:37 PAGE 2   

  55   1          uchar p, savedEA;
  56   1          uint  x;
