  73          /**
  74           * 读取指定通道 ADC, 返回 8bit (0-255)
  75           * 流程: 写控制字(STOP) → 读dummy(NACK+STOP) → 读真实(NACK+STOP)
  76           */
  77          uchar pcf8591ReadADC(uchar channel)
  78          {
  79   1          uchar val;
  80   1      
  81   1          i2cStart();
  82   1          i2cSendByte(PCF_ADDR_W); i2cRecvAck();
  83   1          i2cSendByte(0x40 | (channel & 0x03)); i2cRecvAck();
  84   1          i2cStop();
  85   1      
  86   1          i2cStart();
  87   1          i2cSendByte(PCF_ADDR_R); i2cRecvAck();
  88   1          i2cRecvByte(); i2cSendAck(1);
  89   1          i2cStop();
  90   1      
  91   1          i2cStart();
  92   1          i2cSendByte(PCF_ADDR_R); i2cRecvAck();
  93   1          val = i2cRecvByte(); i2cSendAck(1);
  94   1          i2cStop();
  95   1      
  96   1          return val;
  97   1      }
