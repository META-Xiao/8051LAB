  86   1          i2cStop();
  87   1      
  88   1          i2cStart();
  89   1          i2cSendByte(PCF_ADDR_R); i2cRecvAck();
  90   1          i2cRecvByte(); i2cSendAck(1);
  91   1          i2cStop();
  92   1      
  93   1          i2cStart();
  94   1          i2cSendByte(PCF_ADDR_R); i2cRecvAck();
  95   1          val = i2cRecvByte(); i2cSendAck(1);
  96   1          i2cStop();
  97   1      
  98   1          return val;
  99   1      }
