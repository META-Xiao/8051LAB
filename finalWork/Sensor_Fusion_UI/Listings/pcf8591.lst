  75          /**
  76           * 读取指定通道 ADC, 返回 8bit (0-255)
  77           * 流程: 写控制字(STOP) → 读dummy(NACK+STOP) → 读真实(NACK+STOP)
  78           */
  79          uchar pcf8591ReadADC(uchar channel)
  80          {
  81   1          uchar val;
  82   1      
  83   1          i2cStart();
  84   1          i2cSendByte(PCF_ADDR_W); i2cRecvAck();
