  21          static uchar keyScan(void)
  22          {
  23   1          uchar s1, s2, kc, j;
  24   1          P2 = 0xF0; s1 = P2;
  25   1          if ((s1 & 0xF0) == 0xF0) return 0;
  26   1          { uint d; for (d = 0; d < 6000; d++); }
  27   1          P2 = 0xF0; s1 = P2;
  28   1          if ((s1 & 0xF0) == 0xF0) return 0;
  29   1          P2 = 0x0F; s2 = P2;
  30   1          kc = s1 | s2;
  31   1          for (j = 0; j < 16; j++)
  32   1              if (kc == keyTable[j]) return j + 1;
  33   1          return 0;
  34   1      }
